<Window x:Class="Pixoar.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Pixoar.App.Behaviors"
        Title="{Binding ApplicationTitle}"
        Width="1220"
        Height="780"
        MinWidth="1040"
        MinHeight="660"
        Icon="/Resources/Assets/Branding/pixoar.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}"
          behaviors:DropFilesBehavior.DropCommand="{Binding DropFilesCommand}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="260" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddImagesCommand}"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                            <TextBlock Text="Add Images" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddFolderCommand}"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                            <TextBlock Text="Add Folder" />
                        </StackPanel>
                    </Button>
                    <Button Click="SelectAll_Click"
                            IsEnabled="{Binding HasItems, ElementName=ImageList}"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE762;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                            <TextBlock Text="Select All" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveSelectedCommand}"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                            <TextBlock Text="Remove Selected" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearListCommand}"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE894;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                            <TextBlock Text="Clear List" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="540" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Image List"
                               Style="{StaticResource PageTitleTextBlockStyle}" />
                    <TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Bottom"
                               Text="{Binding LoadedCount, StringFormat={}{0} loaded}"
                               Style="{StaticResource MutedTextBlockStyle}" />
                </DockPanel>

                <ListView x:Name="ImageList"
                          Grid.Row="1"
                          ItemsSource="{Binding Images}"
                          SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                          SelectionMode="Extended"
                          behaviors:ListViewSelectionBehavior.SelectedItems="{Binding SelectedImages}">
                    <ListView.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />
                    </ListView.InputBindings>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="5"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding ThumbnailGlyph}"
                                                           Style="{StaticResource IconTextBlockStyle}"
                                                           FontSize="17"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File Name" Width="260" DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="Resolution" Width="150" DisplayMemberBinding="{Binding Resolution}" />
                            <GridViewColumn Header="Format" Width="80" DisplayMemberBinding="{Binding Format}" />
                            <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding FileSize}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Preview"
                                       Style="{StaticResource PageTitleTextBlockStyle}" />
                            <TextBlock Text="DDS preview uses texconv when available."
                                       Style="{StaticResource MutedTextBlockStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ShowImageInformationCommand}"
                                VerticalAlignment="Top"
                                Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                                <TextBlock Text="Info" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource ChromeBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="270">
                        <Grid>
                            <Image Source="{Binding SelectedImage.PreviewImage}"
                                   Stretch="Uniform"
                                   Margin="12"
                                   Visibility="{Binding SelectedImage.HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="28"
                                        Visibility="{Binding SelectedImage.HasPreviewImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding SelectedImage.PreviewGlyph, TargetNullValue=&#xE91B;}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="64"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedImage.FileName, TargetNullValue=Drop images to begin}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,16,0,0" />
                                <TextBlock Text="{Binding SelectedImage.Resolution, TargetNullValue=Preview placeholder}"
                                           Style="{StaticResource MutedTextBlockStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="File" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedImage.FileName, TargetNullValue=-}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Margin="0,9,0,0" Text="Resolution" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,9,0,0"
                                   Text="{Binding SelectedImage.Resolution, TargetNullValue=-}" />

                        <TextBlock Grid.Row="2" Margin="0,9,0,0" Text="Format" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,9,0,0"
                                   Text="{Binding SelectedImage.Format, TargetNullValue=-}" />

                        <TextBlock Grid.Row="3" Margin="0,9,0,0" Text="File Size" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,9,0,0"
                                   Text="{Binding SelectedImage.FileSize, TargetNullValue=-}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="18,0,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Convert" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Text="Convert selected images to the target format."
                                   Style="{StaticResource MutedTextBlockStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output Format"
                                   Style="{StaticResource LabelTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OutputFormats}"
                                  SelectedItem="{Binding SelectedOutputFormat}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Text="Compression"
                                   Style="{StaticResource LabelTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsDdsOutputFormat, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,14,0,0"
                                  ItemsSource="{Binding DdsCompressionOptions}"
                                  SelectedItem="{Binding SelectedDdsCompression}"
                                  Visibility="{Binding IsDdsOutputFormat, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <Button Grid.Row="2"
                            Command="{Binding ConvertCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                            <TextBlock Text="Convert" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Resize" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Text="Resize selected images with the chosen dimensions and behavior."
                                   Style="{StaticResource MutedTextBlockStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Method"
                                   Style="{StaticResource LabelTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ResizeMethods}"
                                  SelectedItem="{Binding SelectedResizeMethod}" />

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="0,14,0,0"
                              Visibility="{Binding IsDimensionResize, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Width" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="3" Text="Height" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="4" Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,16,0,0"
                                      Content="Keep Aspect Ratio"
                                      IsChecked="{Binding KeepAspectRatio}" />

                            <StackPanel Grid.Row="1"
                                        Grid.Column="3"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <RadioButton Content="Stretch"
                                             GroupName="ResizeMode"
                                             IsChecked="{Binding SelectedResizeMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Stretch}" />
                                <RadioButton Content="Crop"
                                             GroupName="ResizeMode"
                                             IsChecked="{Binding SelectedResizeMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Crop}" />
                                <RadioButton Content="Fit"
                                             GroupName="ResizeMode"
                                             IsChecked="{Binding SelectedResizeMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Fit}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="0,14,0,0"
                              Visibility="{Binding IsPercentageResize, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Percentage"
                                       Style="{StaticResource LabelTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ResizePercentages}"
                                      SelectedItem="{Binding SelectedResizePercentage}" />
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding ResizeEstimateText}"
                                   Style="{StaticResource MutedTextBlockStyle}"
                                   Margin="0,12,0,0" />
                    </Grid>

                    <Button Grid.Row="2"
                            Command="{Binding ResizeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A3;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                            <TextBlock Text="Resize" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,10,0,0"
                    Padding="10,8"
                    CornerRadius="5"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="Errors"
                               Foreground="{StaticResource DangerBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Top" />
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource MutedTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0" LastChildFill="False">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextBlockStyle}" />
                <ProgressBar DockPanel.Dock="Left"
                             Width="150"
                             Height="6"
                             Margin="14,0,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextBlockStyle}"
                           Text="{Binding LoadedCount, StringFormat=Loaded: {0}}" />
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"
                           Style="{StaticResource MutedTextBlockStyle}"
                           Text="{Binding SelectedCount, StringFormat=Selected: {0}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
