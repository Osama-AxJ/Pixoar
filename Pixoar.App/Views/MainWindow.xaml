<Window x:Class="Pixoar.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:Pixoar.App.Behaviors"
        Title="{Binding ApplicationTitle}"
        Width="1220" Height="780" MinWidth="1040" MinHeight="660"
        Icon="/Resources/Assets/Branding/pixoar.ico" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72"
                           ResizeBorderThickness="6"
                           CornerRadius="12"
                           GlassFrameThickness="0"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource AppBackgroundGradient}"
          behaviors:DropFilesBehavior.DropCommand="{Binding DropFilesCommand}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="316" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="52" Height="48" ClipToBounds="True">
                        <Image Source="/Resources/Assets/Branding/pixoar-logo.png" Width="66" Height="66" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="PIXOAR" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,12,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,8,0" /><TextBlock Text="Settings" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeWindow_Click" ToolTip="Minimize"><TextBlock Text="&#xE921;" Style="{StaticResource IconTextBlockStyle}" /></Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="ToggleMaximizeWindow_Click" ToolTip="Maximize or restore"><TextBlock Text="&#xE922;" Style="{StaticResource IconTextBlockStyle}" /></Button>
                    <Button Style="{StaticResource CloseWindowButtonStyle}" Click="CloseWindow_Click" ToolTip="Close"><TextBlock Text="&#xE8BB;" Style="{StaticResource IconTextBlockStyle}" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0A1628" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="24,11,24,10">
                <Button Command="{Binding AddImagesCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="40" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconTextBlockStyle}" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="Add Images" /></StackPanel>
                </Button>
                <Button Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButtonStyle}" MinHeight="40">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconTextBlockStyle}" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0" /><TextBlock Text="Export" /></StackPanel>
                </Button>
                <Button Command="{Binding AddFolderCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextBlockStyle}" Foreground="#FFB36D" Margin="0,0,8,0" /><TextBlock Text="Add Folder" /></StackPanel>
                </Button>
                <Button Click="SelectAll_Click" IsEnabled="{Binding HasItems, ElementName=ImageList}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE762;" Style="{StaticResource IconTextBlockStyle}" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0" /><TextBlock Text="Select All" /></StackPanel>
                </Button>
                <Button Command="{Binding RemoveSelectedCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconTextBlockStyle}" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0" /><TextBlock Text="Remove Selected" /></StackPanel>
                </Button>
                <Button Command="{Binding ClearListCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" Style="{StaticResource IconTextBlockStyle}" Foreground="{StaticResource PurpleBrush}" Margin="0,0,8,0" /><TextBlock Text="Clear List" /></StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,18,24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="540" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" MinWidth="340" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding ActiveListTitle}" Style="{StaticResource PageTitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="11" Padding="11,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveListCount, StringFormat={}{0} images}" Style="{StaticResource LabelTextBlockStyle}" FontWeight="SemiBold" />
                        </Border>
                        <Button DockPanel.Dock="Right" Command="{Binding ShowProcessedImagesCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="10,5" MinHeight="32" Margin="0,0,8,0" ToolTip="Show processed images ready for export.">
                            <TextBlock Text="{Binding ProcessedCount, StringFormat=Processed ({0})}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding ShowSourceImagesCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="10,5" MinHeight="32" Margin="0,0,8,0" ToolTip="Show original images.">
                            <TextBlock Text="{Binding LoadedCount, StringFormat=Originals ({0})}" />
                        </Button>
                    </DockPanel>
                    <ListView x:Name="ImageList" Grid.Row="2" ItemsSource="{Binding DisplayedImages}" SelectedItem="{Binding SelectedImage, Mode=TwoWay}" SelectionMode="Extended" behaviors:ListViewSelectionBehavior.SelectedItems="{Binding SelectedImages}">
                        <ListView.InputBindings><KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" /></ListView.InputBindings>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="64">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding ThumbnailGlyph}" Style="{StaticResource IconTextBlockStyle}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="260" DisplayMemberBinding="{Binding FileName}">
                                    <GridViewColumn.Header><Button Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand" Command="{Binding DataContext.SortImagesCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="FileName" Content="{Binding DataContext.FileNameSortHeader, RelativeSource={RelativeSource AncestorType=ListView}}" /></GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="145" DisplayMemberBinding="{Binding Resolution}">
                                    <GridViewColumn.Header><Button Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand" Command="{Binding DataContext.SortImagesCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="Resolution" Content="{Binding DataContext.ResolutionSortHeader, RelativeSource={RelativeSource AncestorType=ListView}}" /></GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="82" DisplayMemberBinding="{Binding Format}">
                                    <GridViewColumn.Header><Button Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand" Command="{Binding DataContext.SortImagesCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="Format" Content="{Binding DataContext.FormatSortHeader, RelativeSource={RelativeSource AncestorType=ListView}}" /></GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="100" DisplayMemberBinding="{Binding FileSize}">
                                    <GridViewColumn.Header><Button Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand" Command="{Binding DataContext.SortImagesCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="Size" Content="{Binding DataContext.SizeSortHeader, RelativeSource={RelativeSource AncestorType=ListView}}" /></GridViewColumn.Header>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="166" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Preview" Style="{StaticResource PageTitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Command="{Binding ShowImageInformationCommand}" VerticalAlignment="Center" Padding="12,6" MinHeight="34" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" /><TextBlock Text="Info" /></StackPanel>
                        </Button>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#081629" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Image Source="{Binding SelectedImage.PreviewImage}" Stretch="Uniform" Margin="10" Visibility="{Binding SelectedImage.HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" Visibility="{Binding SelectedImage.HasPreviewImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding SelectedImage.PreviewGlyph, TargetNullValue=&#xE91B;}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedImage.FileName, TargetNullValue=Drop images to begin}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedImage.Resolution, TargetNullValue=Select an image to preview}" Style="{StaticResource MutedTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="File" Style="{StaticResource LabelTextBlockStyle}" /><TextBlock Grid.Column="1" Text="{Binding SelectedImage.FileName, TargetNullValue=-}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Margin="0,7,0,0" Text="Resolution" Style="{StaticResource LabelTextBlockStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding SelectedImage.Resolution, TargetNullValue=-}" />
                        <TextBlock Grid.Row="2" Margin="0,7,0,0" Text="Format" Style="{StaticResource LabelTextBlockStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" Text="{Binding SelectedImage.Format, TargetNullValue=-}" />
                        <TextBlock Grid.Row="3" Margin="0,7,0,0" Text="File Size" Style="{StaticResource LabelTextBlockStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" Text="{Binding SelectedImage.FileSize, TargetNullValue=-}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="24,0,24,12">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Canvas Grid.RowSpan="3" Width="118" Height="96" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.20">
                        <Rectangle Canvas.Left="48" Canvas.Top="12" Width="32" Height="32" Fill="{StaticResource PurpleBrush}" />
                        <Rectangle Canvas.Left="81" Canvas.Top="0" Width="20" Height="20" Fill="{StaticResource MagentaBrush}" />
                        <Rectangle Canvas.Left="14" Canvas.Top="54" Width="42" Height="42" Fill="{StaticResource AccentBrush}" />
                    </Canvas>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="29" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top" /><StackPanel><TextBlock Text="Convert" Style="{StaticResource SectionTitleTextBlockStyle}" /><TextBlock Text="Convert selected images to the target format." Style="{StaticResource MutedTextBlockStyle}" Margin="0,3,0,0" /></StackPanel></StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Output Format" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}" />
                        <TextBlock Grid.Row="1" Margin="0,14,0,0" Text="Compression" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Visibility="{Binding IsDdsOutputFormat, Converter={StaticResource BooleanToVisibilityConverter}}" /><ComboBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" ItemsSource="{Binding DdsCompressionOptions}" SelectedItem="{Binding SelectedDdsCompression}" Visibility="{Binding IsDdsOutputFormat, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Button Grid.Row="2" Command="{Binding ConvertCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8AB;" Style="{StaticResource IconTextBlockStyle}" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="{Binding SelectedCount, StringFormat=Convert Selected ({0})}" FontWeight="SemiBold" /></StackPanel></Button>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="166" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Canvas Grid.RowSpan="3" Width="118" Height="96" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.18">
                        <Rectangle Canvas.Left="60" Canvas.Top="10" Width="34" Height="34" Fill="{StaticResource PurpleBrush}" />
                        <Rectangle Canvas.Left="93" Canvas.Top="44" Width="22" Height="22" Fill="{StaticResource MagentaBrush}" />
                        <Rectangle Canvas.Left="25" Canvas.Top="69" Width="26" Height="26" Fill="{StaticResource AccentBrush}" />
                    </Canvas>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="29" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top" /><StackPanel><TextBlock Text="Resize" Style="{StaticResource SectionTitleTextBlockStyle}" /><TextBlock Text="Resize selected images with the chosen dimensions and behavior." Style="{StaticResource MutedTextBlockStyle}" Margin="0,3,0,0" /></StackPanel></StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Method" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ResizeMethods}" SelectedItem="{Binding SelectedResizeMethod}" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Visibility="{Binding IsDimensionResize, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="110" /><ColumnDefinition Width="44" /><ColumnDefinition Width="58" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Width" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <RadioButton Grid.Column="2" Style="{StaticResource AspectRatioRadioStyle}" GroupName="ResizeMode" IsChecked="{Binding IsAspectRatioMode, Mode=TwoWay}" HorizontalAlignment="Center"><TextBlock Text="&#xE71B;" Style="{StaticResource IconTextBlockStyle}" Foreground="{StaticResource CyanBrush}" /></RadioButton>
                            <TextBlock Grid.Column="3" Text="Height" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" /><TextBox Grid.Column="4" Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Mode" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" /><RadioButton Content="Stretch" GroupName="ResizeMode" IsChecked="{Binding SelectedResizeMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Stretch}" Margin="0,0,18,0" /><RadioButton Content="Crop" GroupName="ResizeMode" IsChecked="{Binding SelectedResizeMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Crop}" Margin="0" /></StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Visibility="{Binding IsPercentageResize, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Percentage" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ResizePercentages}" SelectedItem="{Binding SelectedResizePercentage}" /></Grid>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding ResizeEstimateText}" Style="{StaticResource MutedTextBlockStyle}" Margin="0,12,0,0" />
                    </Grid>
                    <Button Grid.Row="2" Command="{Binding ResizeCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8A3;" Style="{StaticResource IconTextBlockStyle}" FontSize="16" Margin="0,0,8,0" /><TextBlock Text="{Binding SelectedCount, StringFormat=Resize Selected ({0})}" FontWeight="SemiBold" /></StackPanel></Button>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel><TextBlock DockPanel.Dock="Left" Text="Errors" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Top" /><ItemsControl ItemsSource="{Binding Errors}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" /><TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextBlockStyle}" /></StackPanel>
                <ProgressBar DockPanel.Dock="Left" Width="150" Height="6" Margin="14,0,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MutedTextBlockStyle}" Text="{Binding LoadedCount, StringFormat=Loaded: {0}}" /><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,18,0" Style="{StaticResource MutedTextBlockStyle}" Text="{Binding SelectedCount, StringFormat=Selected: {0}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
