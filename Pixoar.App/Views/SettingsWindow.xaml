<Window x:Class="Pixoar.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixoar Settings"
        Width="900"
        Height="640"
        MinWidth="820"
        MinHeight="560"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="/Resources/Assets/Branding/pixoar.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextBlockStyle}" />
                <TextBlock Text="Application preferences and Explorer quick actions."
                           Style="{StaticResource MutedTextBlockStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       Style="{StaticResource MutedTextBlockStyle}"
                       TextAlignment="Right"
                       VerticalAlignment="Bottom" />
        </Grid>

        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedPageIndex}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="General" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="General"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />

                            <StackPanel Grid.Row="1"
                                        Margin="0,20,0,0">
                                <CheckBox Content="Check for updates"
                                          IsChecked="{Binding CheckForUpdates}" />
                                <Button Command="{Binding CheckForUpdatesNowCommand}"
                                        Content="{Binding CheckUpdatesButtonText}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="Output" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.ColumnSpan="3"
                                       Text="Output"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />

                            <CheckBox Grid.Row="1"
                                      Grid.ColumnSpan="3"
                                      Margin="0,20,0,0"
                                      Content="Save beside original"
                                      IsChecked="{Binding SaveBesideOriginal}" />

                            <TextBlock Grid.Row="2"
                                       Margin="0,16,18,0"
                                       Text="Custom folder"
                                       Style="{StaticResource LabelTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="0,16,10,0"
                                     Text="{Binding CustomOutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="0,16,0,0"
                                    Command="{Binding BrowseOutputFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                                    <TextBlock Text="Browse" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Row="3"
                                        Grid.ColumnSpan="3"
                                        Margin="0,18,0,0">
                                <TextBlock Text="Output Conflict Behavior"
                                           Style="{StaticResource LabelTextBlockStyle}" />
                                <RadioButton Content="Rename duplicates automatically"
                                             GroupName="OutputConflictBehavior"
                                             IsChecked="{Binding SelectedOutputConflictBehavior, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Rename duplicates automatically}" />
                                <RadioButton Content="Skip existing files"
                                             GroupName="OutputConflictBehavior"
                                             IsChecked="{Binding SelectedOutputConflictBehavior, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Skip existing files}" />
                                <RadioButton Content="Overwrite existing files"
                                             GroupName="OutputConflictBehavior"
                                             IsChecked="{Binding SelectedOutputConflictBehavior, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Overwrite existing files}" />

                                <CheckBox Margin="0,18,0,0"
                                          Content="Save converted files in a &quot;Converted&quot; folder"
                                          IsChecked="{Binding SaveConvertedFilesInConvertedFolder}" />
                                <CheckBox Content="Save resized files in a &quot;Resize&quot; folder"
                                          IsChecked="{Binding SaveResizedFilesInResizeFolder}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="DDS" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.ColumnSpan="2"
                                       Text="DDS Settings"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,22,18,0"
                                       Text="Default DDS Compression"
                                       Style="{StaticResource LabelTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,22,0,0"
                                      ItemsSource="{Binding CompressionOptions}"
                                      SelectedItem="{Binding SelectedCompression}" />

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,20,0,0">
                                <CheckBox Content="Generate mipmaps"
                                          IsChecked="{Binding GenerateMipmaps}" />
                                <CheckBox Content="Preserve alpha"
                                          IsChecked="{Binding PreserveAlpha}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="Quick Actions" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <WrapPanel>
                            <CheckBox Content="Enable Context Menu"
                                      IsChecked="{Binding EnableContextMenu}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,8" />
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,8">
                                <TextBlock Text="Status:"
                                           Style="{StaticResource LabelTextBlockStyle}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ContextMenuInstallationStatusText}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Explorer integration is off by default. Enable it, then select Apply Changes to install the menu."
                                   Style="{StaticResource MutedTextBlockStyle}"
                                   Margin="0,0,0,4" />
                        <WrapPanel>
                            <CheckBox Content="Resize presets"
                                      IsChecked="{Binding EnableResizePresets}"
                                      Margin="0,0,16,8" />
                            <CheckBox Content="Convert presets"
                                      IsChecked="{Binding EnableConvertPresets}"
                                      Margin="0,0,16,8" />
                            <CheckBox Content="Image Information"
                                      IsChecked="{Binding EnableImageInformation}"
                                      Margin="0,0,16,8" />
                            <CheckBox Content="Open in Pixoar"
                                      IsChecked="{Binding EnableOpenInPixoar}"
                                      Margin="0,0,16,8" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Resize Presets"
                                           Style="{StaticResource SectionTitleTextBlockStyle}" />

                                <ListBox Grid.Row="1"
                                         Margin="0,14,0,12"
                                         ItemsSource="{Binding ResizePresets}"
                                         SelectedItem="{Binding SelectedResizePreset}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsEnabled}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <WrapPanel Grid.Row="2">
                                    <Button Command="{Binding AddResizePresetCommand}" Margin="0,0,8,0" Content="Add" />
                                    <Button Command="{Binding RemoveResizePresetCommand}" Margin="0,0,8,0" Content="Remove" />
                                    <Button Command="{Binding MoveResizePresetUpCommand}" Margin="0,0,8,0" Content="Move Up" />
                                    <Button Command="{Binding MoveResizePresetDownCommand}" Content="Move Down" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Convert Formats"
                                           Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock Grid.Row="1"
                                           Text="Select the formats to show under Convert in Explorer."
                                           Style="{StaticResource MutedTextBlockStyle}"
                                           Margin="0,5,0,8" />
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ConvertPresets}"
                                                  VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Margin="0,5,12,5" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="Maintenance" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Maintenance"
                                   Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,18"
                                   Text="Clean Pixoar-owned registry entries, or open local settings and logs."
                                   Style="{StaticResource MutedTextBlockStyle}" />

                        <WrapPanel Grid.Row="2">
                            <Button Command="{Binding CleanRegistryEntriesCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                                    <TextBlock Text="Clean Registry Entries" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenSettingsFolderCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                                    <TextBlock Text="Open Settings Folder" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                                    <TextBlock Text="Open Logs Folder" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border Grid.Row="3"
                                Margin="0,16,0,0"
                                Padding="14"
                                CornerRadius="5"
                                Background="{StaticResource ChromeBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Remove User Data"
                                               Style="{StaticResource SectionTitleTextBlockStyle}" />
                                    <TextBlock Text="Deletes settings and logs in %AppData%\Pixoar after confirmation."
                                               Style="{StaticResource MutedTextBlockStyle}"
                                               Margin="0,4,18,0" />
                                </StackPanel>
                                <Button Command="{Binding RemoveUserDataCommand}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                                        <TextBlock Text="Remove User Data" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="/Resources/Assets/Branding/pixoar-logo.png"
                                   Width="96"
                                   Height="58"
                                   Stretch="Uniform"
                                   Margin="0,0,14,0" />
                            <TextBlock Text="Pixoar"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,6,0,22"
                                   Text="A lightweight native Windows image utility focused on fast conversion, batch processing, resizing, DDS support, and maintainable open source development."
                                   Style="{StaticResource MutedTextBlockStyle}" />

                        <TextBlock Grid.Row="2" Text="Version" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionText}" />

                        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="Website" Style="{StaticResource LabelTextBlockStyle}" />
                        <Button Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Command="{Binding OpenWebsiteCommand}">
                            <TextBlock Text="{Binding WebsiteText}"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Button>

                        <TextBlock Grid.Row="4" Margin="0,12,0,0" Text="GitHub" Style="{StaticResource LabelTextBlockStyle}" />
                        <Button Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Command="{Binding OpenGitHubCommand}">
                            <TextBlock Text="{Binding GitHubText}"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Button>

                        <TextBlock Grid.Row="5" Margin="0,12,0,0" Text="License" Style="{StaticResource LabelTextBlockStyle}" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding LicenseText}" VerticalAlignment="Center" />
                            <Button Command="{Binding ViewLicenseCommand}" Margin="12,0,0,0" Content="View License" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Command="{Binding ApplyChangesCommand}"
                    Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconTextBlockStyle}" Margin="0,0,7,0" />
                    <TextBlock Text="Apply Changes" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
