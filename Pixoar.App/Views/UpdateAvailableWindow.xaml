<Window x:Class="Pixoar.App.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixoar Update"
        Width="430"
        Height="260"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="/Resources/Assets/Branding/pixoar.ico"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource CardBorderStyle}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding LatestVersion, StringFormat=Pixoar v{0} is available.}"
                           Style="{StaticResource SectionTitleTextBlockStyle}" />
                <TextBlock Text="{Binding ReleaseName}"
                           Style="{StaticResource MutedTextBlockStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Current version" Style="{StaticResource LabelTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" />

                <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="Latest version" Style="{StaticResource LabelTextBlockStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding LatestVersion}" />

                <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="Published" Style="{StaticResource LabelTextBlockStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding PublishedAt}" />

                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="2"
                           Margin="0,12,0,0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource MutedTextBlockStyle}" />
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Command="{Binding ViewReleaseCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Content="View Release" />
                <Button Command="{Binding CloseCommand}"
                        Content="{Binding CloseButtonText}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
